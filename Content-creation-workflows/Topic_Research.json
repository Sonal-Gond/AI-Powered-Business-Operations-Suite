    {
      "parameters": {
        "jsCode": "return items.map(item => {\n\n  const date = new Date().toISOString().slice(0,10).replace(/-/g, \"\");\n\n  const keyword = ($input.first().json.output.topic_keyword || \"GENERAL\")\n    .toUpperCase()\n    .replace(/\\s+/g, \"_\");\n\n  const intent = ($input.first().json.output.intent || \"AWARENESS\").toUpperCase();\n\n\n  const content_id = `${date}_${keyword}_${intent}`;\n\n  item.json.content_id = content_id;\n\n  return item;\n});"
      },
