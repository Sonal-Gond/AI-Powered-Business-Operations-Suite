    {
      "parameters": {
        "jsCode": "// ═══════════════════════════════════════════════════════════════\n// MONTHLY REPORT CODE NODE\n// Captures: 1st day → last day of CURRENT month\n// ═══════════════════════════════════════════════════════════════\n\n// Get all incoming data\nconst allRows = $input.all().map(i => i.json);\n\n// Split by sheet (_sheet must be set in Set nodes)\nconst allLeads   = allRows.filter(r => r._sheet === 'leads');\nconst allChats   = allRows.filter(r => r._sheet === 'chats');\nconst allAppts   = allRows.filter(r => r._sheet === 'appts');\nconst allReeng   = allRows.filter(r => r._sheet === 'reeng');\nconst allCalls   = allRows.filter(r => r._sheet === 'calls');\nconst allContent = allRows.filter(r => r._sheet === 'content'); // ✅ NEW\n\n// ── Monthly window ─────────────────────────────────────────────\nconst now = new Date();\n\n// Start of month\nconst monthStart = new Date(now.getFullYear(), now.getMonth(), 1, 0, 0, 0);\n\n// End of month\nconst monthEnd = new Date(now.getFullYear(), now.getMonth() + 1, 0, 23, 59, 59);\n\n// ── Date Parsers (same as your weekly) ─────────────────────────\n\n// DD/MM/YYYY\nfunction parseLeadDate(val) {\n  if (!val) return null;\n  const [mm, dd, yyyy] = val.split('/');\n  return new Date(yyyy, mm - 1, dd);\n}\n\n// ISO\nfunction parseISODate(val) {\n  if (!val) return null;\n  return new Date(val);\n}\n\n// DD/MM/YYYY, time\nfunction parseDDMMTime(val) {\n  if (!val || !val.includes(',')) return null;\n\n  const [datePart, timePart] = val.split(',');\n  const [dd, mm, yyyy] = datePart.trim().split('/');\n\n  let [time, modifier] = timePart.trim().split(' ');\n  let [hours, minutes, seconds] = time.split(':');\n\n  hours = parseInt(hours);\n  minutes = parseInt(minutes);\n  seconds = parseInt(seconds);\n\n  if (modifier === 'pm' && hours < 12) hours += 12;\n  if (modifier === 'am' && hours === 12) hours = 0;\n\n  return new Date(yyyy, mm - 1, dd, hours, minutes, seconds);\n}\n\n// ── Check if inside month ──────────────────────────────────────\nfunction inMonth(d) {\n  return d && d >= monthStart && d <= monthEnd;\n}\n\n// ── Filter data ────────────────────────────────────────────────\nconst monthlyLeads   = allLeads.filter(r => inMonth(parseLeadDate(r.Timestamp)));\nconst monthlyChats   = allChats.filter(r => inMonth(parseISODate(r.created_At)));\nconst monthlyAppts   = allAppts.filter(r => inMonth(parseDDMMTime(r.Timestamp)));\nconst monthlyReeng   = allReeng.filter(r => inMonth(parseDDMMTime(r.Call_time)));\nconst monthlyCalls   = allCalls.filter(r => inMonth(parseDDMMTime(r.Timestamp)));\nconst monthlyContent = allContent.filter(r => inMonth(parseLeadDate(r.Timestamp))); // ✅ NEW\n\n// ── Lead metrics ───────────────────────────────────────────────\nconst totalLeads = monthlyLeads.length;\n\nconst hotLeads  = monthlyLeads.filter(r => (r.Lead_type || '').toLowerCase() === 'hot').length;\nconst warmLeads = monthlyLeads.filter(r => (r.Lead_type || '').toLowerCase() === 'warm').length;\nconst coldLeads = monthlyLeads.filter(r => (r.Lead_type || '').toLowerCase() === 'cold').length;\n\n// ── Call metrics ───────────────────────────────────────────────\nconst totalCalls = monthlyCalls.length;\n\nconst successCalls = monthlyCalls.filter(r =>\n  (r.Call_outcome || '').toLowerCase() === 'success' ||\n  (r.Call_status || '').toLowerCase() === 'completed'\n).length;\n\nconst totalCallCost = monthlyCalls\n  .reduce((sum, r) => sum + Number(r.Call_cost || 0), 0)\n  .toFixed(2);\n\n// ── Chat metrics ───────────────────────────────────────────────\nconst totalChats = monthlyChats.length;\n\nconst avgResolution = totalChats\n  ? (\n      monthlyChats.reduce((sum, r) => sum + Number(r.resolution_rate || 0), 0) /\n      totalChats * 100\n    ).toFixed(1)\n  : '0';\n\n// ── Appointment metrics ────────────────────────────────────────\nconst totalAppts = monthlyAppts.length;\n\nconst confirmedAppts = monthlyAppts.filter(r =>\n  (r.Appintment_status || '').toLowerCase() === 'confirmed'\n).length;\n\n// ── Re-engagement metrics ──────────────────────────────────────\nconst reengContacted = monthlyReeng.length;\n\nconst reengInterested = monthlyReeng.filter(r =>\n  (r.Intent || '').toLowerCase() === 'interested'\n).length;\n\n// ── Content metrics (NEW) ──────────────────────────────────────\nconst totalContent = monthlyContent.length;\n\nconst fullyPublished = monthlyContent.filter(r =>\n  r.Blog_Status === 'Posted' &&\n  r.Facebook_status === 'Posted' &&\n  r.LinkedIn_status === 'Posted'\n).length;\n\nconst pendingContent = monthlyContent.filter(r =>\n  r.Blog_Status !== 'Posted' ||\n  r.Facebook_status !== 'Posted' ||\n  r.LinkedIn_status !== 'Posted'\n).length;\n\n// ── Output ─────────────────────────────────────────────────────\nreturn [{\n  json: {\n    reportType: \"Monthly\",\n    period: `${monthStart.toDateString()} – ${monthEnd.toDateString()}`,\n\n    // Leads\n    totalLeads,\n    hotLeads,\n    warmLeads,\n    coldLeads,\n\n    // Chats\n    totalChats,\n    avgResolution,\n\n    // Calls\n    totalCalls,\n    successCalls,\n    totalCallCost,\n\n    // Appointments\n    totalAppts,\n    confirmedAppts,\n\n    // Re-engagement\n    reengContacted,\n    reengInterested,\n\n    // Content\n    totalContent,\n    fullyPublished,\n    pendingContent\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -16,
