              "description": "user id of these conversation"
            },
            "User_email": {
              "description": "user email that user have provided initially of conversation"
            }
          }
        },
        "69e89c9c781ce3df51c5c16b": {
          "name": "context",
          "description": "These api will called after each response from user",
          "apiCall": {
            "url": "Your_webhhok_url_of context_information",
            "body": [
