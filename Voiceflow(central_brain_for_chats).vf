            },
            "Conversation": {
              "description": "Agent will generate summary of conversation between user and agent "
            },
            "Channel": {
              "description": "The Agent will recognize from which channel user comes "
            },
            "Last_Event": {
              "description": "Last event done by user"
            },
            "Last_Response_user": {
              "description": "last response from user"
            },
            "Last_Response_agent": {
              "description": "last response from agent"
            }
          }
        },
        "69e87661781ce3df51c5b379": {
          "name": "google_lookup",
          "description": "Call the API tool after agent collect user email from user with user_email and user_id",
          "apiCall": {
