    {
      "id": "69e9c192f3dc00cea721ae6a",
      "name": "Is_complete",
      "apiToolID": "69e89c9c781ce3df51c5c16b",
      "description": "Whether the user has completed the full  BANT conversation and their data has been  submitted. Send \"true\" only after Webhook_api  has been called successfully with all BANT  data. Send \"false\" at all other times.  Never send empty or null.",
      "createdAt": "2026-04-24T10:01:39.466Z"
    },
    {
      "id": "69e9c1bcf3dc00cea721ae74",
      "name": "Budget",
      "apiToolID": "69e89c9c781ce3df51c5c16b",
      "description": "The budget amount or range the user mentioned  for their solution, exactly as they said it.  Send only after user has answered the budget  question. Send empty string if not yet  collected. Include currency or units if  user mentioned them.",
      "createdAt": "2026-04-24T10:01:39.467Z"
    },
    {
      "id": "69e9c1d5f3dc00cea721ae79",
      "name": "timeline",
      "apiToolID": "69e89c9c781ce3df51c5c16b",
      "description": "The timeframe or deadline the user wants  the solution implemented, exactly as they  described it. Send only after user has  answered the timeline question. Send empty  string if not yet collected.",
      "createdAt": "2026-04-24T10:01:39.468Z"
    },
    {
      "id": "69e9c1e5f3dc00cea721ae7a",
      "name": "authority",
      "apiToolID": "69e89c9c781ce3df51c5c16b",
      "description": "Whether the user is the main decision maker  or if others are involved in approval,  exactly as the user described it. Send only  after user has answered the authority  question. Send empty string if not yet  collected.",
      "createdAt": "2026-04-24T10:01:39.469Z"
    },
    {
      "id": "69e9c1fcf3dc00cea721ae7b",
      "name": "need",
      "apiToolID": "69e89c9c781ce3df51c5c16b",
      "description": "The user's primary business need or problem  they want to solve, exactly as they described  it. Send only after user has answered the  need question in BANT. Send empty string if  not yet collected. Never summarize or change  what the user said.",
