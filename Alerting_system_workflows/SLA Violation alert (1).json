      "id": "46ca2b33-5ecf-48c0-b6de-458a59264ea3",
      "name": "Fetching only last hour system log"
    },
    {
      "parameters": {
        "jsCode": "const total = items.length;\n\nconst success = items.filter(\n  i => i.json.Status === \"Success\"\n).length;\n\nconst failed = items.filter(\n  i =>\n    i.json.Status === \"Error\" ||\n    i.json.Status === \"Failed\"\n).length;\n\nconst uptime =\nNumber(((success / total) * 100).toFixed(2));\n\nconst failureRate =\nNumber(((failed / total) * 100).toFixed(2));\n\nreturn [{\n  json: {\n    total,\n    success,\n    failed,\n    uptime,\n    failureRate\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
