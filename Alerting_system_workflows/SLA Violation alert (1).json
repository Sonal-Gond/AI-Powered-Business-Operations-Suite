    {
      "parameters": {
        "jsCode": "const uptime =\nparseFloat($json.uptime);\n\nlet severity = \"Healthy\";\n\nif (uptime < 95) {\n  severity = \"Critical\";\n}\nelse if (uptime < 99) {\n  severity = \"High\";\n}\nelse if (uptime < 99.9) {\n  severity = \"Medium\";\n}\n\nreturn [{\n  json: {\n    ...$json,\n    severity\n  }\n}];"
      },
