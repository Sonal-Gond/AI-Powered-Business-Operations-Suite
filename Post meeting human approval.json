    {
      "parameters": {
        "jsCode": "const now = new Date();\n\nfunction parseMMDDYYYY(dateStr, timeStr) {\n  if (!dateStr || !timeStr) return null;\n\n  // Parse date: MM/DD/YYYY\n  const [month, day, year] = dateStr.split(\"/\").map(Number);\n  if (!month || !day || !year) return null;\n\n  // Parse time: 2:00:00 PM\n  const match = timeStr.match(/(\\d+):(\\d+):(\\d+)\\s*(AM|PM)/i);\n  if (!match) return null;\n\n  let [_, h, m, s, ampm] = match;\n  h = Number(h);\n  m = Number(m);\n  s = Number(s);\n\n  if (ampm.toUpperCase() === \"PM\" && h !== 12) h += 12;\n  if (ampm.toUpperCase() === \"AM\" && h === 12) h = 0;\n\n  return new Date(year, month - 1, day, h, m, s || 0);\n}\n\nreturn items.filter(item => {\n  const data = item.json;\n\n  const start = parseMMDDYYYY(\n    data.Appointmnet_date,\n    data.Appointment_time\n  );\n\n  if (!start) return false;\n\n  const durationHours = Number(data.Appointment_hour || 0);\n\n  const end = new Date(start.getTime() + durationHours * 60 * 60 * 1000);\n\n  return now > end;\n});"
      },
