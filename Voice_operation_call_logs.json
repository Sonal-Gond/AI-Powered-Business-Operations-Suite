    {
      "parameters": {
        "jsCode": "const reason = ($json.endedReason || \"\").toLowerCase();\nconst transcript = ($json.transcript || \"\").toLowerCase();\n\n// calculate duration safely\nlet duration = 0;\nif ($json.startedAt && $json.endedAt) {\n  duration =\n    (new Date($json.endedAt) - new Date($json.startedAt)) / 1000;\n}\n\n// =====================\n// 🎯 CALL STATUS\n// =====================\n\nlet status = \"Unknown\";\n\n// 1. NOT ANSWERED\nif (\n  reason.includes(\"did-not-answer\") ||\n  reason.includes(\"busy\") ||\n  reason.includes(\"voicemail\")\n) {\n  status = \"Not Answered\";\n}\n\n// 2. FAILED (infra / provider / system)\nelse if (\n  reason.includes(\"error\") ||\n  reason.includes(\"failed\") ||\n  reason.includes(\"transport\") ||\n  reason.includes(\"worker-died\") ||\n  reason.includes(\"provider\")\n) {\n  status = \"Failed\";\n}\n\n// 3. COMPLETED (normal end)\nelse if (\n  reason.includes(\"assistant-ended-call\") ||\n  reason.includes(\"customer-ended-call\") ||\n  reason.includes(\"completed\") ||\n  reason.includes(\"max-duration\") ||\n  reason.includes(\"silence-timed-out\")\n) {\n  status = \"Completed\";\n}\n\n// 4. FALLBACK USING DURATION\nelse if (duration === 0) {\n  status = \"Not Answered\";\n} else if (duration < 10) {\n  status = \"Abandoned\";\n} else {\n  status = \"Completed\";\n}\n\n// =====================\n// 🎯 CALL OUTCOME (GENERIC)\n// =====================\n\nlet outcome = \"Failed\";\n\n// Not answered = always failed\nif (status === \"Not Answered\") {\n  outcome = \"Failed\";\n}\n\n// strong success signals\nelse if (\n  transcript.includes(\"thank you\") ||\n  transcript.includes(\"resolved\") ||\n  transcript.includes(\"scheduled\") ||\n  transcript.includes(\"done\")\n) {\n  outcome = \"Success\";\n}\n\n// engagement based\nelse if (duration > 60) {\n  outcome = \"Partial\";\n}\nelse if (duration > 20) {\n  outcome = \"Partial\";\n}\nelse {\n  outcome = \"Failed\";\n}\n\n// =====================\n// RETURN\n// =====================\n\nreturn [{\n  json: {\n    ...$json,\n    call_status: status,\n    call_outcome: outcome,\n    duration_sec: duration\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
